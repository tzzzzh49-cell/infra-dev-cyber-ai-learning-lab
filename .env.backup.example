# Exemple de configuration Restic locale.
# Copier vers un fichier privé non commité, puis définir les valeurs hors Git.

RESTIC_REPOSITORY=outputs/backups/restic-local
RESTIC_PASSWORD_FILE=
RESTIC_EXCLUDE_FILE=backup/restic-excludes.txt

# Optionnel : liste de chemins à sauvegarder, séparés par des espaces.
# Laisser vide pour utiliser la sélection prudente par défaut des scripts.
RESTIC_BACKUP_PATHS=
