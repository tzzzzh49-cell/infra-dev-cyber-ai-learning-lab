APP_NAME=infra-dev-cyber-ai-learning-lab
APP_ENV=vps
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_FILE=/workspace/outputs/logs/app.log
DIAG_ACCESS_TOKEN_HASH=
DIAG_ACCESS_TOKEN_HASH_FILE=
DIAG_PROTECTION_DISABLED=false
LAB_DOMAIN=
ADMIN_EMAIL=

# L'exposition publique doit passer par Caddy ou un autre reverse proxy HTTPS.
# Ne pas exposer directement /diag sur Internet.
# /diag et les exports refusent l'accès si aucun hash de token n'est configuré.
# Stocker DIAG_ACCESS_TOKEN_HASH via un gestionnaire de secrets ou un fichier privé.
# DIAG_PROTECTION_DISABLED est ignoré hors développement local.
# LAB_DOMAIN et ADMIN_EMAIL doivent rester des placeholders ou être définis hors dépôt.
# Ne jamais placer de secrets réels dans ce fichier.
