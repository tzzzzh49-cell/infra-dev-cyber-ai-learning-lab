APP_NAME=infra-dev-cyber-ai-learning-lab
APP_ENV=vps
APP_HOST=127.0.0.1
APP_PORT=8000
DIAG_ACCESS_TOKEN=
DIAG_ACCESS_TOKEN_SHA256=
DIAG_COMMAND_TIMEOUT=3
DIAG_COMMAND_RETRIES=0
LAB_DOMAIN=
ADMIN_EMAIL=
POSTGRES_DB=lab_reports
POSTGRES_USER=lab
POSTGRES_PASSWORD=

# L'exposition publique doit passer par Caddy ou un autre reverse proxy HTTPS.
# Ne pas exposer directement /diag sur Internet.
# En mode APP_ENV=vps, /diag et les exports refusent l'accès si aucun jeton ou hash
# de jeton n'est configuré.
# Préférer DIAG_ACCESS_TOKEN_SHA256 pour l'application. DIAG_ACCESS_TOKEN ne doit
# être défini que dans un fichier privé non commité, par exemple si Caddy injecte
# X-Diag-Token vers l'API locale.
# POSTGRES_* est préparatoire pour le profil Compose future-persistence et ne doit
# pas contenir de mot de passe réel dans cet exemple.
# LAB_DOMAIN et ADMIN_EMAIL doivent rester des placeholders ou être définis hors dépôt.
# Ne jamais placer de secrets réels dans ce fichier.
