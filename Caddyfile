api.infra-lab-thom.fr {
	@oauth2 path /oauth2/*
	handle @oauth2 {
		header Cache-Control "no-store"
		reverse_proxy oauth2-proxy:4180 {
			header_up -X-Diag-Token
			header_up -X-Authenticated-User
			header_up -X-Forwarded-Access-Token
			header_up X-Verified-Client-IP {remote_host}
		}
	}

	@diagnostics path /diag*
	handle @diagnostics {
		header Cache-Control "no-store"
		reverse_proxy oauth2-proxy:4180 {
			header_up -X-Diag-Token
			header_up -X-Authenticated-User
			header_up -X-Forwarded-Access-Token
			header_up X-Verified-Client-IP {remote_host}
		}
	}

	@api_docs path /docs* /redoc* /openapi.json
	handle @api_docs {
		respond 404
	}

	handle {
		reverse_proxy api:8000 {
			header_up -Authorization
			header_up -X-Diag-Token
			header_up -X-Authenticated-User
			header_up -X-Forwarded-Access-Token
			header_up X-Verified-Client-IP {remote_host}
		}
	}
}

infra-lab-thom.fr {
	respond "Secure AI Ops Lab" 200
}

www.infra-lab-thom.fr {
	redir https://infra-lab-thom.fr{uri} permanent
}
