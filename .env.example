APP_NAME=infra-dev-cyber-ai-learning-lab
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_FILE=/workspace/outputs/logs/app.log
DIAG_ACCESS_TOKEN_HASH=
DIAG_ACCESS_TOKEN_HASH_FILE=
DIAG_PROTECTION_DISABLED=false
DIAG_COMMAND_TIMEOUT=3
DIAG_COMMAND_RETRIES=0

# Sécurité locale :
# 127.0.0.1 expose uniquement sur la machine locale.
# Ne pas utiliser 0.0.0.0 sans authentification et sans reverse proxy sécurisé.
# /diag est protégé par défaut, même en local.
# Générer un hash avec scripts/generate_diag_token.py et le stocker hors Git.
# DIAG_PROTECTION_DISABLED=true est réservé au développement local explicite.
# DIAG_COMMAND_TIMEOUT garde une valeur courte par défaut ; l'augmenter seulement
# si l'environnement est lent et rester dans une limite raisonnable.
