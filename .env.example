APP_NAME=infra-dev-cyber-ai-learning-lab
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
DIAG_ACCESS_TOKEN=
DIAG_ACCESS_TOKEN_SHA256=
DIAG_COMMAND_TIMEOUT=3
DIAG_COMMAND_RETRIES=0

# Sécurité locale :
# 127.0.0.1 expose uniquement sur la machine locale.
# Ne pas utiliser 0.0.0.0 sans authentification et sans reverse proxy sécurisé.
# DIAG_ACCESS_TOKEN peut rester vide en local. Préférer DIAG_ACCESS_TOKEN_SHA256
# pour protéger /diag sans stocker de jeton en clair côté application.
# DIAG_COMMAND_TIMEOUT garde une valeur courte par défaut ; l'augmenter seulement
# si l'environnement est lent et rester dans une limite raisonnable.
