[Unit]
Description=Infra Lab public Nginx proxy stack
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=<SERVICE_USER>
Group=<SERVICE_GROUP>
SupplementaryGroups=docker
WorkingDirectory=<PROJECT_ROOT>
Environment=MTLS_DIR=<MTLS_DIR>
Environment=OAUTH2_SOCKET_DIR=/var/lib/infra-lab/oauth2-proxy
ExecStartPre=+<PROJECT_ROOT>/scripts/check_mtls_files.sh
ExecStartPre=/usr/bin/docker compose -f compose.yaml -f compose.public.yaml --profile public-proxy config --quiet
ExecStart=/usr/bin/docker compose -f compose.yaml -f compose.public.yaml --profile public-proxy up
ExecStop=/usr/bin/docker compose -f compose.yaml -f compose.public.yaml --profile public-proxy stop
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
